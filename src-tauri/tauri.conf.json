{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC GUI",
  "version": "1.1.0",
  "identifier": "com.zhukunpenglinyutong.ccgui",
  "build": {
    "beforeDevCommand": "npx vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://hm.baidu.com blob: pluginasset: http://pluginasset.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost http://hm.baidu.com https://hm.baidu.com pluginasset: http://pluginasset.localhost https:; connect-src 'self' ipc: http://ipc.localhost pluginasset: http://pluginasset.localhost; media-src 'self' blob: pluginasset: http://pluginasset.localhost; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**"
          ],
          "deny": [
            "$HOME/.ssh/**",
            "$HOME/.aws/**",
            "$HOME/.gnupg/**",
            "$HOME/.ccgui-next/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/agent-catalogs": "agent-catalogs",
      "resources/skills": "skills"
    },
    "createUpdaterArtifacts": true,
    "targets": "all",
    "linux": {
      "rpm": {
        "compression": {
          "type": "zstd",
          "level": 3
        },
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3",
          "librsvg2"
        ]
      }
    },
    "macOS": {
      "signingIdentity": "Developer ID Application: kunpeng zhu (RLHBM56QRH)"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCOUY2RkIzOUFFNTBBQjgKUldTNEN1V2FzMitmeXpxVWkxMXUrM05UVHRJQTNaTHNZcVo4SktSQUJNSVM2VDEzSzVtaUhHWGcK",
      "endpoints": [
        "https://github.com/zhukunpenglinyutong/desktop-cc-gui/releases/latest/download/latest.json"
      ]
    }
  }
}
